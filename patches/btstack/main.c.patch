 #define USB_VENDOR_ID_REALTEK 0x0bda
 
+// DS3Bridge: Realtek-based dongles sold under another vendor ID. BTstack only recognises
+// Realtek's own vendor ID, so map these to the Realtek product ID of their chip (the same
+// list Linux's btusb uses). Without the firmware download they don't accept connections.
+#include <limits.h>
+#include <stdlib.h>
+#include <libgen.h>
+static char ds3_firmware_dir[PATH_MAX] = ".";
+static uint16_t ds3_realtek_product_id(uint16_t vid, uint16_t pid){
+    if (vid == USB_VENDOR_ID_REALTEK) return pid;
+    static const uint16_t oem[][3] = {
+        { 0x2357, 0x0604, 0x8771 },   // TP-Link UB500 / UB5A (RTL8761BUV)
+        { 0x0b05, 0x190e, 0x8771 },   // ASUS USB-BT500 (RTL8761BUV)
+    };
+    for (unsigned i = 0; i < sizeof(oem) / sizeof(oem[0]); i++)
+        if (oem[i][0] == vid && oem[i][1] == pid) return oem[i][2];
+    return 0;
+}
+
